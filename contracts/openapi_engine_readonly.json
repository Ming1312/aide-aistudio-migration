  "/v1/datasets/{dataset_id}/series": {
   "get": {
    "summary": "Series",
    "operationId": "series_v1_datasets__dataset_id__series_get",
    "parameters": [
     {
      "name": "dataset_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Dataset Id"
      }
     },
     {
      "name": "columns",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "description": "逗號分隔的欄位名稱（最多 12 個）",
       "title": "Columns"
      },
      "description": "逗號分隔的欄位名稱（最多 12 個）"
     },
     {
      "name": "start",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start"
      }
     },
     {
      "name": "end",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "End"
      }
     },
     {
      "name": "resample",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(none|1D)$",
       "default": "none",
       "title": "Resample"
      }
     },
     {
      "name": "max_points",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 5000,
       "minimum": 10,
       "default": 3000,
       "title": "Max Points"
      }
     },
     {
      "name": "x-api-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
