 "components": {
  "schemas": {
   "ForecastReq": {
    "properties": {
     "dataset_id": {
      "type": "string",
      "title": "Dataset Id"
     },
     "sensor": {
      "type": "string",
      "title": "Sensor"
     },
     "horizon_h": {
      "type": "integer",
      "maximum": 6.0,
      "minimum": 1.0,
      "title": "Horizon H"
     },
     "origin": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Origin",
      "description": "預測起點（整點，例如 2026-08-10 12:00:00）；省略＝資料最後一個可用的起點"
     },
     "history_hours": {
      "type": "integer",
      "maximum": 168.0,
      "minimum": 6.0,
      "title": "History Hours",
      "default": 72
     }
    },
    "type": "object",
    "required": [
     "dataset_id",
     "sensor",
     "horizon_h"
    ],
    "title": "ForecastReq"
   },
   "FormalReq": {
    "properties": {
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of",
      "description": "預測時間點（整點）；省略＝資料最後一筆"
     },
     "mode": {
      "type": "string",
      "pattern": "^(strict|full)$",
      "title": "Mode",
      "description": "strict＝只用『當時已經存在』的凍結模型（嚴格歷史回測）；full＝全資料模型（只供示範，樣本內）",
      "default": "strict"
     }
    },
    "type": "object",
    "title": "FormalReq"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  },
  "securitySchemes": {
   "ApiKey": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key"
   }
  }
 },
 "servers": [
  {
   "url": "${ENGINE_BASE_URL}"
  }
 ]
